generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PPC
  ENGINEERING
  PROCUREMENT
  PROJECT
  OPERATIONS
  VIEWER
}

enum VendorCategory {
  MECHANICAL
  MULTI_DISCIPLINE
  CIVIL
  HVAC
  MEP
  OTHERS
}

enum Stage {
  PPC
  ENGINEERING
  PROCUREMENT
  PROJECT
  OPERATIONS
}

enum OverallStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PpcStatus {
  DRAFT
  SUBMITTED
  APPROVED
  COMPLETED
}

enum EngineeringStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProcurementStatus {
  NOT_STARTED
  VENDORS_INVITED
  EVALUATION
  WINNER_SELECTED
  PO_ISSUED
}

enum PaymentStageStatus {
  PLANNED
  INVOICED
  PAID
}

enum ProjectExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum HandoverStatus {
  NOT_STARTED
  HANDED_OVER
  WARRANTY
  CLOSED
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  username           String    @unique @db.VarChar(50)
  fullName           String    @map("full_name") @db.VarChar(120)
  role               Role
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  createdProjects   Project[]          @relation("ProjectCreator")
  assignedPpc       PpcRequest[]       @relation("PpcPic")
  tenderDocuments   TenderDocument[]   @relation("EngineerTenders")
  projectExecutions ProjectExecution[] @relation("ExecutionPic")
  vendorReviews     VendorReview[]     @relation("Reviewer")
  progressUpdates   ProgressUpdate[]   @relation("ProgressActor")
  attachments       Attachment[]       @relation("AttachmentUploader")
  auditLogs         AuditLog[]         @relation("AuditActor")

  @@map("users")
}

model Vendor {
  id          String         @id @default(uuid()) @db.Char(36)
  name        String         @unique @db.VarChar(150)
  category    VendorCategory
  contactName String?        @map("contact_name") @db.VarChar(120)
  phone       String?        @db.VarChar(30)
  email       String?        @db.VarChar(150)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  tenderInvitations TenderInvitation[]
  purchaseOrders    PurchaseOrder[]
  vendorReviews     VendorReview[]

  @@index([category], map: "idx_vendors_category")
  @@map("vendors")
}

model Project {
  id            String        @id @default(uuid()) @db.Char(36)
  name          String        @db.VarChar(200)
  department    String?       @db.VarChar(150)
  currentStage  Stage         @default(PPC) @map("current_stage")
  overallStatus OverallStatus @default(IN_PROGRESS) @map("overall_status")
  createdBy     String?       @map("created_by") @db.Char(36)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt     DateTime?     @map("deleted_at") @db.DateTime(3)

  creator           User?              @relation("ProjectCreator", fields: [createdBy], references: [id])
  ppcRequest        PpcRequest?
  tenderDocuments   TenderDocument[]
  tenderInvitations TenderInvitation[]
  purchaseOrder     PurchaseOrder?
  projectExecution  ProjectExecution?
  handover          Handover?
  vendorReviews     VendorReview[]
  progressUpdates   ProgressUpdate[]
  attachments       Attachment[]

  @@index([currentStage, overallStatus], map: "idx_projects_stage")
  @@map("projects")
}

model PpcRequest {
  id         String    @id @default(uuid()) @db.Char(36)
  projectId  String    @unique @map("project_id") @db.Char(36)
  requestNo  String    @unique @map("request_no") @db.VarChar(30)
  letterNo   String?   @map("letter_no") @db.VarChar(80)
  letterDate DateTime? @map("letter_date") @db.Date
  typeCode   String?   @map("type_code") @db.VarChar(20)
  picId      String?   @map("pic_id") @db.Char(36)
  targetDate DateTime  @map("target_date") @db.Date
  handoffTo  String?   @map("handoff_to") @db.VarChar(50)
  status     PpcStatus @default(DRAFT)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pic     User?   @relation("PpcPic", fields: [picId], references: [id])

  @@index([status, targetDate], map: "idx_ppc_target")
  @@map("ppc_requests")
}

model TenderDocument {
  id          String            @id @default(uuid()) @db.Char(36)
  projectId   String            @map("project_id") @db.Char(36)
  tenderNo    String            @unique @map("tender_no") @db.VarChar(40)
  revision    Int               @default(0)
  engineerId  String?           @map("engineer_id") @db.Char(36)
  startDate   DateTime?         @map("start_date") @db.Date
  finishDate  DateTime?         @map("finish_date") @db.Date
  workingDays Int?              @map("working_days")
  progressPct Int               @default(0) @map("progress_pct") @db.UnsignedTinyInt
  status      EngineeringStatus @default(NOT_STARTED)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User?   @relation("EngineerTenders", fields: [engineerId], references: [id])

  @@index([projectId], map: "idx_td_project")
  @@index([engineerId, status], map: "idx_td_engineer")
  @@index([status, finishDate], map: "idx_td_finish")
  @@map("tender_documents")
}

model TenderInvitation {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @map("project_id") @db.Char(36)
  vendorId  String   @map("vendor_id") @db.Char(36)
  bidAmount BigInt?  @map("bid_amount")
  isWinner  Boolean  @default(false) @map("is_winner")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([projectId, vendorId], map: "uq_invite")
  @@map("tender_invitations")
}

model PurchaseOrder {
  id        String            @id @default(uuid()) @db.Char(36)
  projectId String            @unique @map("project_id") @db.Char(36)
  vendorId  String            @map("vendor_id") @db.Char(36)
  poNo      String            @unique @map("po_no") @db.VarChar(40)
  amount    BigInt
  issuedAt  DateTime          @map("issued_at") @db.Date
  status    ProcurementStatus @default(PO_ISSUED)

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  paymentStages PaymentStage[]

  @@map("purchase_orders")
}

model PaymentStage {
  id         String             @id @default(uuid()) @db.Char(36)
  poId       String             @map("po_id") @db.Char(36)
  name       String             @db.VarChar(80)
  percentage Decimal            @db.Decimal(5, 2)
  amount     BigInt
  dueDate    DateTime?          @map("due_date") @db.Date
  paidAt     DateTime?          @map("paid_at") @db.Date
  status     PaymentStageStatus @default(PLANNED)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId], map: "idx_pay_po")
  @@index([status, dueDate], map: "idx_pay_due")
  @@map("payment_stages")
}

model ProjectExecution {
  id          String                 @id @default(uuid()) @db.Char(36)
  projectId   String                 @unique @map("project_id") @db.Char(36)
  picId       String?                @map("pic_id") @db.Char(36)
  startDate   DateTime?              @map("start_date") @db.Date
  finishDate  DateTime?              @map("finish_date") @db.Date
  progressPct Int                    @default(0) @map("progress_pct") @db.UnsignedTinyInt
  status      ProjectExecutionStatus @default(NOT_STARTED)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pic     User?   @relation("ExecutionPic", fields: [picId], references: [id])

  @@map("project_executions")
}

model Handover {
  id                  String         @id @default(uuid()) @db.Char(36)
  projectId           String         @unique @map("project_id") @db.Char(36)
  handoverDate        DateTime?      @map("handover_date") @db.Date
  warrantyMonths      Int?           @map("warranty_months")
  warrantyEnd         DateTime?      @map("warranty_end") @db.Date
  retentionPct        Decimal?       @map("retention_pct") @db.Decimal(5, 2)
  retentionAmount     BigInt?        @map("retention_amount")
  retentionReleasedAt DateTime?      @map("retention_released_at") @db.Date
  status              HandoverStatus @default(NOT_STARTED)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, warrantyEnd], map: "idx_handover_warranty")
  @@map("handovers")
}

model VendorReview {
  id                 String   @id @default(uuid()) @db.Char(36)
  vendorId           String   @map("vendor_id") @db.Char(36)
  projectId          String?  @map("project_id") @db.Char(36)
  reviewerId         String   @map("reviewer_id") @db.Char(36)
  technicalScore     Decimal  @map("technical_score") @db.Decimal(5, 2)
  nonTechnicalScore  Decimal  @map("non_technical_score") @db.Decimal(5, 2)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviewer User     @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([vendorId], map: "idx_rev_vendor")
  @@map("vendor_reviews")
}

model ProgressUpdate {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @map("project_id") @db.Char(36)
  stage     Stage
  oldValue  String?  @map("old_value") @db.VarChar(100)
  newValue  String?  @map("new_value") @db.VarChar(100)
  note      String?  @db.Text
  actorId   String   @map("actor_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation("ProgressActor", fields: [actorId], references: [id])

  @@index([projectId, createdAt], map: "idx_pu_project")
  @@map("progress_updates")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Char(36)
  projectId  String?  @map("project_id") @db.Char(36)
  stage      String?  @db.VarChar(20)
  fileName   String   @map("file_name") @db.VarChar(255)
  storageKey String   @map("storage_key") @db.VarChar(500)
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt?  @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader User?    @relation("AttachmentUploader", fields: [uploadedBy], references: [id])

  @@index([projectId], map: "idx_att_project")
  @@map("attachments")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorId   String?  @map("actor_id") @db.Char(36)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(50)
  diff      Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_time")
  @@map("audit_logs")
}

model Holiday {
  holidayDate DateTime @id @map("holiday_date") @db.Date
  name        String   @db.VarChar(120)

  @@map("holidays")
}

model Setting {
  settingKey   String @id @map("setting_key") @db.VarChar(80)
  settingValue Json   @map("setting_value")

  @@map("settings")
}

model ScoreConfig {
  id                 Int     @id @default(1) @db.UnsignedTinyInt
  technicalWeight    Decimal @default(0.600) @map("technical_weight") @db.Decimal(4, 3)
  nonTechnicalWeight Decimal @default(0.400) @map("non_technical_weight") @db.Decimal(4, 3)
  threshold          Decimal @default(70.00) @db.Decimal(5, 2)

  @@map("score_config")
}

model DocSequence {
  docType    String @map("doc_type") @db.VarChar(10)
  docYear    Int    @map("doc_year") @db.SmallInt
  lastNumber Int    @default(0) @map("last_number")

  @@id([docType, docYear])
  @@map("doc_sequences")
}
